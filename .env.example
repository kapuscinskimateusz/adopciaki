# Skopiuj do .env.local i uzupełnij po założeniu projektu Supabase.
# Nigdy nie commituj .env.local ani prawdziwych kluczy.

# Adres publiczny aplikacji (używany m.in. w linkach auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings -> API
# Do czasu podłączenia projektu zostaw puste - aplikacja działa w trybie bez Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# TYLKO serwer. Pomiń, dopóki nie jest potrzebny. Nigdy nie dodawaj prefiksu NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
