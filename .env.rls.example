# Konfiguracja testów RLS. Skopiuj do .env.rls.local (ignorowany przez Git) i uzupełnij.
# Używaj WYŁĄCZNIE projektu Supabase dev i jednorazowych kont testowych.
# Nigdy nie dodawaj tu klucza service_role ani nie commituj .env.rls.local.

# Supabase: Project Settings -> API (URL projektu dev i klucz publiczny anon/publishable)
SUPABASE_RLS_URL=
SUPABASE_RLS_ANON_KEY=

# Konta testowe utworzone w Authentication -> Users (potwierdzone e-maile)
SUPABASE_RLS_ADOPTER_A_EMAIL=
SUPABASE_RLS_ADOPTER_A_PASSWORD=
SUPABASE_RLS_ADOPTER_B_EMAIL=
SUPABASE_RLS_ADOPTER_B_PASSWORD=
# Konto z rolą staff nadaną ręcznie w SQL (profiles.role = 'staff')
SUPABASE_RLS_STAFF_EMAIL=
SUPABASE_RLS_STAFF_PASSWORD=
